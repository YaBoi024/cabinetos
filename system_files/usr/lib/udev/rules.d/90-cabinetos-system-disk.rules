# The drive CabinetOS boots from is hidden from drive lists: Steam's Storage
# page offered to format it (#223). When CabinetOS boots from a drive that can
# be unplugged (a portable install), every drive of the PC that cannot is
# hidden too, so that PC's own system and files are never touched.
# /usr/libexec/cabinetos-system-disk says why, and how each is found.
SUBSYSTEM=="block", ACTION=="add|change", ENV{DEVTYPE}=="disk|partition", PROGRAM="/usr/libexec/cabinetos-system-disk %k", RESULT=="system|pc", ENV{UDISKS_IGNORE}="1"
