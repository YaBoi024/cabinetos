diff --git a/frontend/src/idlesleep.cpp b/frontend/src/idlesleep.cpp
new file mode 100644
index 0000000..1b39414
--- /dev/null
+++ b/frontend/src/idlesleep.cpp
@@ -0,0 +1,59 @@
+#include "idlesleep.h"
+
+#include <dirent.h>
+
+#include <cstdio>
+#include <fstream>
+#include <string>
+
+#include "prefs.h"
+
+namespace idlesleep {
+namespace {
+
+int gIndex = 2;   // 30 minutes
+
+std::string readWord(const std::string& path) {
+    std::ifstream f(path);
+    std::string s;
+    std::getline(f, s);
+    return s;
+}
+
+}  // namespace
+
+void load() {
+    const std::string w = prefs::get("sleep_after", "30m");
+    gIndex = 2;
+    for (int i = 0; i < kCount; ++i)
+        if (w == kChoices[i].word) gIndex = i;
+    std::fprintf(stderr, "[idle] sleep on battery after %s\n", kChoices[gIndex].name);
+}
+
+int index() { return gIndex; }
+
+void set(int i) {
+    if (i < 0 || i >= kCount) return;
+    gIndex = i;
+    prefs::set("sleep_after", kChoices[i].word);
+}
+
+double seconds() { return kChoices[gIndex].seconds; }
+
+bool onBattery() {
+    DIR* d = ::opendir("/sys/class/power_supply");
+    if (!d) return false;
+    bool sawMains = false, pluggedIn = false;
+    while (dirent* e = ::readdir(d)) {
+        if (e->d_name[0] == '.') continue;
+        const std::string dir = std::string("/sys/class/power_supply/") + e->d_name;
+        const std::string type = readWord(dir + "/type");
+        if (type != "Mains" && type.rfind("USB", 0) != 0) continue;
+        sawMains = true;
+        if (readWord(dir + "/online") == "1") pluggedIn = true;
+    }
+    ::closedir(d);
+    return sawMains && !pluggedIn;
+}
+
+}  // namespace idlesleep
diff --git a/frontend/src/idlesleep.h b/frontend/src/idlesleep.h
new file mode 100644
index 0000000..d3f6bb4
--- /dev/null
+++ b/frontend/src/idlesleep.h
@@ -0,0 +1,43 @@
+// FORK (handheld): put the machine to sleep when nobody is using it and it is
+// running on its battery.
+//
+// The screen already dims and blanks on its own (idle.h) and a blanked
+// handheld still burns its battery for hours. This is the step after: the
+// "Sleep when idle" setting, in Settings under Display and Sound. It acts only
+// when ALL of these hold:
+//   - the machine has a battery and is NOT plugged in (a console on a TV has
+//     no mains supply entry to lose, so it never sleeps itself);
+//   - no game is loaded (a paused game is left alone);
+//   - nothing has been touched for the chosen time, and at least as long as
+//     the screen-off time, so the screen always goes out first.
+// Sleeping is logind's, through power::act(Rest): the same path as the Power
+// menu's Rest, which leaves a game properly and takes the delay lock.
+
+#pragma once
+
+namespace idlesleep {
+
+struct Choice {
+    const char* name;
+    const char* word;   // as saved in config/settings.json
+    double seconds;     // 0 is never
+};
+static constexpr Choice kChoices[] = {
+    {"Never", "never", 0.0},
+    {"20 minutes", "20m", 20 * 60.0},
+    {"30 minutes", "30m", 30 * 60.0},
+    {"1 hour", "1h", 60 * 60.0},
+};
+constexpr int kCount = sizeof kChoices / sizeof kChoices[0];
+
+// Reads the saved choice (default 30 minutes). Call once at start.
+void load();
+int index();
+void set(int i);   // remembers it and saves it
+double seconds();
+
+// True when the machine has a mains supply entry and none is online. False on
+// a machine with no such entry, and when the answer cannot be read.
+bool onBattery();
+
+}  // namespace idlesleep
