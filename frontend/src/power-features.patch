index 0000000..c08d1b5
--- /dev/null
+++ b/system_files/usr/libexec/cabinetos-charge-limit
@@ -0,0 +1,31 @@
+#!/usr/bin/env bash
+#
+# FORK (handheld): the Steam Deck's battery charge limit.
+#
+#   cabinetos-charge-limit <percent>    80, 90 or 100 (100 is no limit)
+#
+# Run only by cabinetos-charge-limit@.service (the percent is the instance
+# name), which the console starts through 68-cabinetos-charge.rules. The Deck's
+# controller holds the battery at the level written to
+# max_battery_charge_level on its steamdeck_hwmon device; 0 means no limit.
+# Measured on an OLED: 0 at start, and 80 reads back as 80.
+#
+# A machine without that device is left alone, with exit 0: the setting is not
+# shown there either (frontend/src/chargelimit.cpp).
+set -euo pipefail
+
+percent="${1:-}"
+case "${percent}" in
+    80|90) value="${percent}" ;;
+    100) value=0 ;;
+    *) echo "cabinetos-charge-limit: 80, 90 or 100, not '${percent}'" >&2; exit 2 ;;
+esac
+
+for dir in /sys/class/hwmon/hwmon*; do
+    [ "$(cat "${dir}/name" 2>/dev/null)" = "steamdeck_hwmon" ] || continue
+    [ -e "${dir}/max_battery_charge_level" ] || continue
+    echo "${value}" > "${dir}/max_battery_charge_level"
+    echo "charge limit: ${percent}% (wrote ${value} to ${dir})"
+    exit 0
+done
+echo "no steamdeck_hwmon charge limit here; nothing to do"
diff --git a/system_files/usr/share/polkit-1/rules.d/68-cabinetos-charge.rules b/system_files/usr/share/polkit-1/rules.d/68-cabinetos-charge.rules
new file mode 100644
index 0000000..77aef05
--- /dev/null
+++ b/system_files/usr/share/polkit-1/rules.d/68-cabinetos-charge.rules
@@ -0,0 +1,17 @@
+// The Steam Deck's battery charge limit, set from Settings. /usr/libexec/
+// cabinetos-charge-limit; frontend/src/chargelimit.cpp.
+//
+// `subject.local`, as in 67-cabinetos-pads.rules: the console on its own seat,
+// not an SSH session.
+polkit.addRule(function(action, subject) {
+    if (action.id != "org.freedesktop.systemd1.manage-units" ||
+        subject.user != "cabinet" || !subject.local) {
+        return polkit.Result.NOT_HANDLED;
+    }
+    var unit = action.lookup("unit");
+    if (action.lookup("verb") == "start" && unit &&
+        /^cabinetos-charge-limit@(80|90|100)\.service$/.test(unit)) {
+        return polkit.Result.YES;
+    }
+    return polkit.Result.NOT_HANDLED;
+});
