diff --git a/frontend/src/chargelimit.cpp b/frontend/src/chargelimit.cpp
new file mode 100644
index 0000000..3b9b4be
--- /dev/null
+++ b/frontend/src/chargelimit.cpp
@@ -0,0 +1,58 @@
+#include "chargelimit.h"
+
+#include <cstdio>
+#include <string>
+#include <thread>
+
+#include "prefs.h"
+#include "proc.h"
+
+namespace chargelimit {
+namespace {
+
+bool fileThere() {
+    static const bool there = [] {
+        const proc::Result r = proc::run(
+            {"sh", "-c", "for d in /sys/class/hwmon/hwmon*; do "
+                         "[ \"$(cat $d/name 2>/dev/null)\" = steamdeck_hwmon ] && "
+                         "[ -e $d/max_battery_charge_level ] && exit 0; done; exit 1"}, 5);
+        return r.ok();
+    }();
+    return there;
+}
+
+void write(int percent) {
+    std::thread([percent] {
+        const std::string unit =
+            "cabinetos-charge-limit@" + std::to_string(percent) + ".service";
+        const proc::Result r = proc::run({"systemctl", "--no-ask-password", "start", unit}, 15);
+        std::fprintf(stderr, "[charge] limit %d%%: %s\n", percent,
+                     r.ok() ? "set" : ("not set: " + r.err).c_str());
+    }).detach();
+}
+
+}  // namespace
+
+bool available() { return fileThere(); }
+
+int savedIndex() {
+    const std::string w = prefs::get("charge_limit", "100");
+    for (int i = 0; i < kCount; ++i)
+        if (w == kChoices[i].word) return i;
+    return kCount - 1;
+}
+
+void set(int i) {
+    if (i < 0 || i >= kCount || !fileThere()) return;
+    prefs::set("charge_limit", kChoices[i].word);
+    write(kChoices[i].percent);
+}
+
+void applySaved() {
+    static bool done = false;
+    if (done || !fileThere()) return;
+    done = true;
+    write(kChoices[savedIndex()].percent);
+}
+
+}  // namespace chargelimit
diff --git a/frontend/src/chargelimit.h b/frontend/src/chargelimit.h
new file mode 100644
index 0000000..645fc5c
--- /dev/null
+++ b/frontend/src/chargelimit.h
@@ -0,0 +1,43 @@
+// FORK (handheld): the battery's charge limit, for a Steam Deck.
+//
+// The Deck's controller keeps the battery from charging past a level it is
+// given, in `max_battery_charge_level` on the `steamdeck_hwmon` device (0 is no
+// limit). Held at 80% a battery lasts far more charge cycles. Root owns the
+// file and the console does not run as root, so the write is done by
+// cabinetos-charge-limit@<percent>.service (system_files/usr/libexec/
+// cabinetos-charge-limit), which a polkit rule lets the console start.
+//
+// The setting is the "Battery charge limit" row under Display and Sound. It is
+// shown only where the file exists. The saved choice is written again at every
+// start, in case the controller forgets it across a restart.
+
+#pragma once
+
+namespace chargelimit {
+
+struct Choice {
+    const char* name;
+    const char* word;   // as saved in config/settings.json
+    int percent;        // 100 is no limit
+};
+static constexpr Choice kChoices[] = {
+    {"80%", "80", 80},
+    {"90%", "90", 90},
+    {"No limit", "100", 100},
+};
+constexpr int kCount = sizeof kChoices / sizeof kChoices[0];
+
+// Whether this machine has the Deck's charge-limit file.
+bool available();
+
+// The saved choice's index (default: no limit).
+int savedIndex();
+
+// Asks for choice `i`, saves it, and returns at once: the write happens on a
+// worker. Safe to call on a machine without the file (it does nothing).
+void set(int i);
+
+// Applies the saved choice, once per run. Called at start.
+void applySaved();
+
+}  // namespace chargelimit
