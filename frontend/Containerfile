# The CabinetOS frontend build environment.
#
# The OS image itself carries no compiler and no headers, deliberately: it is a
# console, not a build machine. So the frontend is built in here and the binary
# is copied out.
#
# Fedora 44 because that is what Bazzite 44 is built from, so glibc and every
# runtime library the binary links against match the image it will run on. If
# the base image's Fedora release moves, move this with it.
FROM registry.fedoraproject.org/fedora:44

RUN dnf install -y --setopt=install_weak_deps=False \
        gcc gcc-c++ make pkgconf-pkg-config \
        cmake nasm \
        git \
        SDL3-devel SDL3_image-devel \
        mesa-libEGL-devel \
        mesa-libGLES-devel \
        mesa-libGL-devel \
        vulkan-headers vulkan-loader-devel \
        wayland-devel freetype-devel libjpeg-turbo-devel libpng-devel \
        libcurl-devel json-c-devel libarchive-devel \
        zlib-ng-compat-devel libzip-devel alsa-lib-devel systemd-devel \
        openssl-devel gstreamer1-devel gstreamer1-plugins-base-devel \
        gstreamer1-plugins-bad-free-devel pipewire-devel gupnp-igd-devel \
    && dnf clean all

# vulkan-headers is for the frontend's own Vulkan path, and vulkan-loader-devel
# is NOT for linking against. Nothing here links libvulkan: gpu.cpp opens it
# with dlopen so the binary still starts on the test VM, which has no Vulkan
# device at all. The devel package is here for the headers' pkg-config file and
# so a mistake that DOES link it fails in the container rather than on the
# console. See frontend/src/gpu.h, and docs/PROJECT.md open question 20.

# libarchive is for ROMs, which arrive in whatever format their owner has —
# zip, 7z, plain, or no extension at all. See frontend/src/romfile.h.
#
# libcurl and json-c are for the RomM client (Phase 4). Both are already present
# in the OS image, so linking against them adds nothing to what ships — but
# "already present" is not the same as "guaranteed", which is what
# build_files/require-frontend-libs.sh is for.

# cmake, nasm and the three libraries on the last line are for the CORES too,
# and none of them is reached by the frontend's own build:
#
#   * cmake — mGBA and Flycast have no Makefile.libretro. mGBA's upstream
#     dropped it; Flycast never had one.
#   * nasm — mupen64plus's x86-64 recompiler assembles with it. Cabinet builds
#     that core with no recompiler at all, so this exists to build the OTHER
#     side of that comparison, which is how the question gets settled.
#   * mesa-libGL — the desktop GL the unix branch of a hardware-rendered core
#     links against by default, where Apple's build takes GLES.
#   * zlib-ng-compat, libzip, alsa-lib, systemd(udev) — Flycast's host-side
#     dependencies. It vendors most of its deps as submodules and expects
#     these from the system.

# openssl, gstreamer1, pipewire and gupnp-igd are for the LinkUp program only
# (linkup/, #654): its own Noise, the stream, the capture and the port it asks a
# router for. The frontend links none of them: it holds no internet code for
# LinkUp (ci/check-linkup-no-network.sh).

# git is here for the CORES, not for us. Several libretro Makefiles do
#   GIT_VERSION := $(shell git rev-parse --short HEAD)
# and compile it into the string the core reports as its own version. Build
# without git and the core forgets which revision it is — which is exactly the
# fact the whole core-parity problem is about. See docs/PROJECT.md, open
# question 13.
WORKDIR /src
